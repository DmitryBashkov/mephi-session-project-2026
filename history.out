   52  # Раздел 1. Установка дистрибутива (5 баллов)
   53  # === task 1.1 ===
   54  ip a > ip-output
   55  echo $(cat ip-output) 
   56  echo "[  DONE  ] task 1.2"
   57  # === task 1.2 ===
   58  hostnamectl set-hostname mephi-2026.domain.local
   59  echo "[  DONE  ] task 1.2"
   60  # === task 1.3 ===
   61  ping -c 4 8.8.8.8 > ping.out
   62  echo "[  DONE  ] task 1.3"
   63  # Раздел 2. Управление программным обеспечением (5 баллов)
   64  # === task 2.1 ===
   65  dnf update -y
   66  echo echo "[  DONE  ] task 2.1"
   67  # === task 2.2 ===
   68  dnf install -y nginx libcap-ng-utils acl
   69  echo "[  DONE  ] task 2.2"
   70  # === task 2.3 ==="
   71  mkdir -p /tmp/packages
   72  dnf download tcpdump --resolve --destdir /tmp/packages
   73  rpm -ivh /tmp/packages/tcpdump*.rpm
   74  dnf history > dnf.out
   75  echo "[  DONE  ] task 2.3"
   76  # Раздел 3. Управление файловыми системами (5 баллов)
   77  # === task 3.1 ===
   78  parted -s /dev/sdb mklabel gpt
   79  parted -s /dev/sdb mkpart primary ext4 0% 100%
   80  mkfs.ext4 -L MEPHI_WEB /dev/sdb1
   81  echo "[  DONE  ] task 3.1"
   82  # === task 3.2 ===
   83  mkdir /mephi-web
   84  echo 'LABEL=MEPHI_WEB /mephi-web ext4 defaults 1 2' >> /etc/fstab
   85  systemctl daemon-reload
   86  mount -a
   87  echo "[  DONE  ] task 3.2"
   88  # Раздел 4. Управление сервисами (5 баллов)
   89  # === task 4.1 ===
   90  systemctl start nginx
   91  systemctl enable nginx
   92  echo "[  DONE  ] task 4.1"
   93  # === task 4.2 ===
   94  journalctl -u nginx -b > journalctl.out
   95  echo "[  DONE  ] task 4.1"
   96  # Раздел 5. Управление доступом (15 баллов)
   97  # === task 5.1 ==="
   98  mkdir -p -m 2770 /data/mephi-2026
   99  groupadd users
  100  groupadd -g 4444 curators
  101  chgrp users /datamephi-2026
  102  useradd -u 5501 -m -G users user1 
  103  useradd -u 5502 -m -G users user2
  104  useradd -u 5503 -m -G users user3
  105  useradd -m -G curators curator1
  106  useradd -m -G curators curator2
  107  setfacl -m g:curators:r-X -m d:g:curators:r-X /data/mephi-2026
  108  echo "[  DONE  ] task 5.1"
  109  # === task 5.2 ===
  110  chmod u-s /usr/sbin/tcpdump
  111  setcap cap_net_raw,cap_net_admin+eip /usr/sbin/tcpdump
  112  sudo -u user1 tcpdump -i any -c 4 > tcp.dump
  113  echo "[  DONE  ] task 5.2"
  114  # === task 5.3 ===
  115  semanage fcontext -a -t httpd_sys_content_t '/mephi-web(/.*)?'
  116  restorecon -Rv /mephi-web
  117  getenforce
  118  echo "[  DONE  ] task 5.3"
  119  # Раздел 6. Аутентификация (5 баллов)
  120  # === task 6.1 ===
  121  usermod -s /sbin/nologin curator1
  122  usermod -s /sbin/nologin curator2
  123  # === task 6.2 ===
  124  chage -M 90 user1
  125  chage -M 90 user2
  126  chage -M 90 user3
  127  chage -M 90 curator1
  128  chage -M 90 curator2
  129  echo 'minlen = 12' >> /etc/security/pwquality.conf
  130  echo "[  DONE  ] task 6.1"
  131  # Раздел 7. Тестирование (5 баллов)
  132  # === task 7.1 ===
  133  echo 'Hello from Student: 12345' > /mephi-web/index.html
  134  chmod 664 /mephi-web/index.html
  135  chgrp users /mephi-web/index.html
  136  restorecon -Rv /mephi-web
  137  echo "[  DONE  ] task 7.1"
  138  # === task 7.2 ===
  139  curl http://localhost/
  140  echo "[  DONE  ] task 7.2"
